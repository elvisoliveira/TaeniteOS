table Config
  FontName: sans
  FontSize: 9
  FontColor: #ffffff
  Antialias: true
  Bold: false
  ClickDelay: 300
  SingleClick: false
  IconSnap: true
  SnapWidth: 20
  SnapHeight: 20
  SnapOrigin: BottomRight
  SnapShadow: false
  SnapShadowTrans: 150
  CaptionOnHover: false
  CaptionPlacement: bottom
  Shadow: true
  ShadowColor: #000000
  ShadowOpacity: 70
  ShadowX: 2
  ShadowY: 2
  Background.Color: #004F9E
  Background.Source: file
  Background.File: /usr/share/backgrounds/taenite/nl/tools.jpg
  Background.Mode: Center
end
table Actions
  Lock: none
  Reload: middle doubleClk
  Drag: none
  EndDrag: none
  Execute[0]: left doubleClk
  Execute[1]: right doubleClk
end
